# Copia a .env.local y rellena. Todo esto es OPCIONAL: sin nada de esto el
# front arranca, cae al motor local y la pantalla dice de dónde vienen los datos.

# Backend. Si falta, http://localhost:8000
NEXT_PUBLIC_CARDIOTWIN_API=http://localhost:8000

# --- Portal ----------------------------------------------------------------
# Publishable key. ES LA UNICA credencial de Portal que puede vivir en el
# navegador, y es segura en el bundle. La secret key (sk_...) NO va aqui bajo
# ningun concepto: api.useportal.co rechaza cualquier peticion con header
# Origin, asi que ni funcionaria, y filtrarla dejaria a cualquiera publicando
# en el canal de vitales.
#
# Sin esta variable Portal queda desactivado y el front usa el SSE. Es asi a
# proposito: se desarrolla sin credenciales de Portal.
NEXT_PUBLIC_PORTAL_PK=

# Tiene que coincidir con CARDIOTWIN_SIM_ID del backend, o los ids de canal no
# cuadran, el JWT no los lleva en su ACL y el canal queda en "blocked".
NEXT_PUBLIC_CARDIOTWIN_SIM_ID=demo

# Nombre visible en la presencia del canal. Viaja en claims.username del JWT.
NEXT_PUBLIC_CARDIOTWIN_USER=Equipo de guardia
