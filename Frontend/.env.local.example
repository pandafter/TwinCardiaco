# Copia esto a .env.local y pon la key. NUNCA se commitea .env.local.
#
# Sin esta variable la app funciona igual: /api/ask y /api/agents devuelven
# 503 y el frontend cae a las reglas locales, marcándolo en pantalla. Con
# ella, las preguntas y las tres opiniones las produce el modelo de verdad.
#
# La key vive solo en el servidor. El navegador nunca la ve: por eso son
# route handlers y no una llamada desde el componente.
ANTHROPIC_API_KEY=sk-ant-...
