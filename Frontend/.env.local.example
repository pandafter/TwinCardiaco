# Copia esto a .env.local. NUNCA se commitea el archivo real.
# Las claves pueden quedar vacías: la app degrada de forma explícita.

# Server-side: nunca llega al navegador.
ANTHROPIC_API_KEY=

# Backend FastAPI.
NEXT_PUBLIC_CARDIOTWIN_API=http://localhost:8000

# Portal: la pk_ es pública; la sk_ solo vive en Backend/.env.
NEXT_PUBLIC_PORTAL_PK=

# Debe coincidir con CARDIOTWIN_SIM_ID del backend.
NEXT_PUBLIC_CARDIOTWIN_SIM_ID=demo
NEXT_PUBLIC_CARDIOTWIN_USER=Equipo de guardia
