# Copia este archivo como Backend/.env. No commitees el archivo real.
# Las claves pueden quedar vacías: la demo degrada a reglas locales y SSE.
ANTHROPIC_API_KEY=
PORTAL_SECRET_KEY=

# Debe coincidir con NEXT_PUBLIC_CARDIOTWIN_SIM_ID del frontend.
CARDIOTWIN_SIM_ID=demo
CARDIOTWIN_TIME_SCALE=8
CARDIOTWIN_ASYSTOLE_S=120
CARDIOTWIN_ASK_MODEL=claude-opus-5
CARDIOTWIN_AGENT_MODEL=claude-opus-5
CARDIOTWIN_DELTA_MS=150

